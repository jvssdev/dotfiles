{{- $p := .colorScheme.palette -}}

* {
  border: none;
  border-radius: 0px;
  font-family: "JetBrainsMono Nerd Font";
  font-weight: bold;
  font-size: 15px;
  min-height: 13px;
}

@define-color background #{{ $p.base00 }};
@define-color foreground #{{ $p.base0D }};
@define-color focused #{{ $p.base0E }};
@define-color urgent #{{ $p.base08 }};
@define-color bluetooth #{{ $p.base0C }};

window#waybar {
  background: @background;
  color: @foreground;
}
window#waybar.hidden {
  background: transparent;
}

#tags {
  padding: 0px 6px;
}
#custom-player,
#custom-record,
#custom-inbox,
#bluetooth,
#custom-mute,
#battery,
#custom-clock {
  padding: 0px 12px;
}

#tags button {
  padding: 0px 6px;
  min-width: 0px;
  border-radius: 0px;
  color: @foreground;
}
#tags button.occupied {
  color: @foreground;
}
#tags button.focused {
  color: @focused;
}
#tags button.urgent {
  color: @urgent;
}

#battery.warning,
#battery.critical {
  color: @foreground;
}

#bluetooth.on {
  color: @bluetooth;
}
