{{ if eq .chezmoi.osRelease.id "opensuse-tumbleweed" -}}
#!/bin/bash
set -e

echo "Installing openSUSE Tumbleweed packages..."

# Function to add OBS repository if not already added
add_obs_repo() {
    local repo_name=$1
    local repo_url=$2
    
    if ! zypper lr | grep -q "$repo_name"; then
        echo "Adding OBS repository: $repo_name"
        sudo zypper ar -f -G "$repo_url" "$repo_name"
    else
        echo "Repository $repo_name already exists"
    fi
}

# Add recommended OBS repositories
echo "Setting up OBS repositories..."

# Themes
add_obs_repo "themes" \
    "https://download.opensuse.org/repositories/X11:common:Factory/openSUSE_Tumbleweed/"

# Fonts
add_obs_repo "fonts" \
    "https://download.opensuse.org/repositories/M17N:fonts/openSUSE_Tumbleweed/"

# Network utilities
add_obs_repo "network-utils" \
    "https://download.opensuse.org/repositories/network:utilities/openSUSE_Tumbleweed/"

# Refresh repositories
echo "Refreshing repositories..."
sudo zypper refresh

# Install base zypper packages
packages_list=""
{{ range .packages.opensuse.zypper.base -}}
package={{ . | quote }}
packages_list="$packages_list $package"
{{ end -}}

{{- if eq .windowmanager "river" }}
echo "Adding River window manager packages..."
{{ range .packages.opensuse.zypper.river -}}
package={{ . | quote }}
packages_list="$packages_list $package"
{{ end -}}
{{- end }}

if [ -n "$packages_list" ]; then
    echo "Installing zypper packages..."
    # --no-confirm: non-interactive
    # --no-recommends: don't install recommended packages (optional)
    sudo zypper install --no-confirm $packages_list
fi

# Install base OBS packages
packages_list=""
{{ range .packages.opensuse.obs.base -}}
package={{ . | quote }}
packages_list="$packages_list $package"
{{ end -}}

{{- if eq .windowmanager "river" }}
echo "Adding River OBS packages..."
{{ range .packages.opensuse.obs.river -}}
package={{ . | quote }}
packages_list="$packages_list $package"
{{ end -}}
{{- end }}

if [ -n "$packages_list" ]; then
    echo "Installing OBS packages..."
    
    # Try to install each package individually to handle failures gracefully
    for package in $packages_list; do
        if zypper se -i "$package" &>/dev/null; then
            echo "Package $package already installed, skipping..."
        elif zypper se "$package" | grep -q "$package"; then
            echo "Installing $package..."
            sudo zypper install --no-confirm "$package" || {
                echo "Warning: Failed to install $package. It may not be available."
                echo "You can try installing it manually later."
            }
        else
            echo "Warning: Package $package not found in repositories."
            echo "You may need to install it manually or from another source."
        fi
    done
fi

# Special handling for packages that might need manual installation
echo ""
echo "=== Manual installation notes ==="

# wleave check
if ! command -v wleave &>/dev/null; then
    echo "wleave not found. May need to build from source:"
    echo "  https://github.com/AMNatty/wleave"
fi

# Docker setup
if command -v docker &>/dev/null; then
    if ! groups | grep -q docker; then
        echo ""
        echo "=== Docker Configuration ==="
        echo "Adding current user to docker group..."
        sudo usermod -aG docker "$USER"
        echo "✓ You need to log out and back in for docker group to take effect"
    fi
    
    if ! systemctl is-enabled docker.service &>/dev/null; then
        echo "Enabling docker service..."
        sudo systemctl enable docker.service
        sudo systemctl start docker.service
    fi
fi

# Libvirt setup
if command -v virsh &>/dev/null; then
    if ! groups | grep -q libvirt; then
        echo ""
        echo "=== Libvirt Configuration ==="
        echo "Adding current user to libvirt group..."
        sudo usermod -aG libvirt "$USER"
        echo "You need to log out and back in for libvirt group to take effect"
    fi
    
    if ! systemctl is-enabled libvirtd.service &>/dev/null; then
        echo "Enabling libvirtd service..."
        sudo systemctl enable libvirtd.service
        sudo systemctl start libvirtd.service
    fi
fi

echo ""
echo "==================================="
echo "Package installation completed!"
echo "==================================="
{{ end -}}
